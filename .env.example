# Portable KEY=value syntax; scripts do not execute shell expressions or expand $.
# Optional: set an absolute JDK 25 directory if automatic discovery is unsuitable.
# JAVA_HOME=/absolute/path/to/jdk-25
AZURE_FUNCTIONS_ENVIRONMENT=Development
SPRING_PROFILES_ACTIVE=local
FUNCTIONS_WORKER_RUNTIME=java
AzureWebJobsStorage=UseDevelopmentStorage=true
EVENT_HUB_NAME=topic_one
EVENT_HUB_CONSUMER_GROUP=$Default
EVENT_HUB_CONNECTION=<local-event-hub-connection-string>
SERVICE_BUS_TOPIC_NAME=generic_events
SERVICE_BUS_CONNECTION=<local-service-bus-connection-string>
WEBHOOK_SIGNATURE_ENABLED=false
WEBHOOK_HMAC_SECRET=<local-secret>
WEBHOOK_SIGNATURE_HEADER=X-Signature
WEBHOOK_TIMESTAMP_ENABLED=true
WEBHOOK_TIMESTAMP_HEADER=X-Timestamp
WEBHOOK_MAX_AGE_SECONDS=300
